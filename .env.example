# Copy to .env.local and fill in from Supabase → Project Settings → API.
# .env.local is gitignored; never commit real keys.

# Safe to expose in a browser. Read access is still governed by RLS.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Bypasses RLS entirely. Local seeding only — never commit, never ship
# to the browser, never add to Vercel unless a server function needs it.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
